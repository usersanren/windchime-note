{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindChimeNote",
  "mainBinaryName": "WindChimeNote",
  "version": "1.0.0",
  "identifier": "com.windchime.notewidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "WindChimeNote",
    "copyright": "Copyright © 2026 WindChimeNote",
    "category": "Utility",
    "shortDescription": "悬挂式桌面励志便签",
    "longDescription": "风铃便签：从桌面顶部垂下的手绘风便签纸，每天送你一句二十字励志短句。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
